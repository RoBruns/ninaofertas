# Intervalo de verificação em segundos
CHECK_INTERVAL=60

# Banco de dados
DATABASE_URL=sqlite:///ofertas.db

# Docker Compose (Evolution + Postgres) — senha forte, não commitar
POSTGRES_PASSWORD=

# WhatsApp (evolution-api — https://github.com/EvolutionAPI/evolution-api)
EVOLUTION_API_URL=http://localhost:8080
EVOLUTION_API_KEY=sua_chave
EVOLUTION_INSTANCE=minha-instancia
# Número do bot (só dígitos, ex. 558531791835) — checagem de admin no grupo
EVOLUTION_BOT_NUMBER=
WHATSAPP_GROUP_ID=120363xxxxxx@g.us
WHATSAPP_GROUP_ID_AUTO=120363xxxxxx@g.us

# Reenvio quando o preço cai (%)
REENVIO_QUEDA_MINIMA=15

# Shopee Afiliados — Open API
SHOPEE_APP_ID=
SHOPEE_APP_SECRET=

# Mercado Livre Afiliados (createLink) — renove o cookie quando expirar (401)
MERCADOLIVRE_AFFILIATE_TAG=
MERCADOLIVRE_AFFILIATE_COOKIE=

# Nível de log: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
