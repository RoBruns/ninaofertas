# Copie para .env e preencha. O .env nunca vai para o git.
# Em produção, estes valores ficam nas Variables de cada serviço da Railway.

# ─── Banco (worker e API) ─────────────────────────────────────────────────────
# Local: um Postgres seu (veja o README). Nunca aponte para o banco de produção.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ninaofertas

# ─── Worker (o bot) ───────────────────────────────────────────────────────────
CHECK_INTERVAL=60
LOG_LEVEL=INFO
REENVIO_QUEDA_MINIMA=15

# Evolution API (infraestrutura). Instância, telefone, grupos e credenciais de
# Shopee/ML NÃO ficam aqui: são cadastrados no dashboard (ADR-020).
EVOLUTION_API_URL=http://localhost:8080
EVOLUTION_API_KEY=
# Docker Compose local (Evolution + Postgres): use uma senha forte.
POSTGRES_PASSWORD=

# O cookie do Mercado Livre e renovado no dashboard quando expirar (401).

# Heartbeat do worker para a API (opcional: sem os dois, o worker só não envia).
API_URL=http://localhost:8000
WORKER_TOKEN=
WORKER_ID=worker-local

# ─── Worker e API ─────────────────────────────────────────────────────────────
# Chave-mestra que cifra cookies/tokens das contas (AES-GCM, 32 bytes base64).
# TEM de ser a mesma no worker e na API. Perdê-la torna as credenciais ilegíveis.
#   python -c "import base64,secrets;print(base64.b64encode(secrets.token_bytes(32)).decode())"
CREDENTIALS_KEY=

# ─── API ──────────────────────────────────────────────────────────────────────
#   python -c "import secrets;print(secrets.token_urlsafe(64))"
JWT_SECRET=
# Origens do dashboard em desenvolvimento (em produção o dashboard faz proxy e
# não precisa de CORS).
CORS_ORIGINS=http://localhost:5173

# Usuário admin criado por `python -m core.seed` (só na primeira vez).
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ─── Testes ───────────────────────────────────────────────────────────────────
# Banco DESCARTÁVEL: os testes apagam o schema public inteiro. A suíte se recusa
# a rodar num banco chamado `railway` (produção).
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ninaofertas_test
# METRICS_LATENCY_CHECK=1   # só com o banco na mesma rede (ex.: dentro da Railway)
