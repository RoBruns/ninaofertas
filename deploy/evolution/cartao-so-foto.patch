+  private async buildCustomLinkPreview(card: LinkPreviewCard, text: string) {
+    const fromCard = (card.canonicalUrl || '').trim();
+    const fromText = text.match(/https?:\/\/[^\s<>]+/)?.[0]?.replace(/[).,]+$/u, '') || '';
+    const url = fromCard || fromText;
+    if (!url) {
+      throw new BadRequestException('linkPreview sem URL canônica');
+    }
+
+    let image: Buffer | undefined;
+    try {
+      if (card.thumbnailBase64) {
+        image = Buffer.from(card.thumbnailBase64.replace(/^data:[^;]+;base64,/, ''), 'base64');
+      } else if (card.thumbnailUrl) {
+        const response = await axios.get(card.thumbnailUrl, {
+          responseType: 'arraybuffer',
+          timeout: 10000,
+          maxContentLength: 5 * 1024 * 1024,
+          maxBodyLength: 5 * 1024 * 1024,
+        });
+        image = Buffer.from(response.data);
+      }
+    } catch (error) {
+      this.logger.error(`Error preparing the link preview picture: ${error}`);
+      throw new BadRequestException('falha ao montar a foto do linkPreview');
+    }
+
+    if (!image?.length) {
+      throw new BadRequestException('linkPreview sem miniatura');
+    }
+
+    // Sem título o WhatsApp descarta a prévia; U+200B deixa só a foto e o domínio.
+    const info: any = {
+      'canonical-url': url,
+      'matched-text': url,
+      title: card.title || '\u200B',
+    };
+    if (card.description) info.description = card.description;
+
+    // O Baileys às vezes não gera a miniatura (fica em branco no celular): geramos aqui.
+    let foto: Buffer;
+    let miniatura: Buffer;
+    let largura: number | undefined;
+    let altura: number | undefined;
+    try {
+      foto = await sharp(image, { animated: false }).rotate().flatten({ background: '#ffffff' }).jpeg({ quality: 85 }).toBuffer();
+      const meta = await sharp(foto).metadata();
+      largura = meta.width;
+      altura = meta.height;
+      miniatura = await sharp(foto).resize({ width: 192 }).jpeg({ quality: 60 }).toBuffer();
+    } catch (error) {
+      this.logger.error(`Error converting the link preview picture: ${error}`);
+      throw new BadRequestException('falha ao converter a foto do linkPreview');
+    }
+
+    try {
+      const { imageMessage } = await prepareWAMessageMedia(
+        { image: foto, jpegThumbnail: miniatura, width: largura, height: altura } as any,
+        { upload: this.client.waUploadToServer, mediaTypeOverride: 'thumbnail-link' } as any,
+      );
+      info.jpegThumbnail = miniatura;
+      if (imageMessage) {
+        imageMessage.width = imageMessage.width || largura;
+        imageMessage.height = imageMessage.height || altura;
+      }
+      info.highQualityThumbnail = imageMessage || undefined;
+    } catch (error) {
+      this.logger.error(`Error uploading the link preview picture: ${error}`);
+      throw new BadRequestException('falha ao subir a foto do linkPreview');
+    }
+
+    if (!info.jpegThumbnail || !info.highQualityThumbnail) {
+      throw new BadRequestException('linkPreview sem miniatura após upload');
+    }
+    return info;
+  }
